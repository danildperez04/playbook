{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/v17.11.2/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "pull-request-title-pattern": "chore(repo): release ${version}",
  "pull-request-header": "Release preparado por release-please a partir de los Conventional Commits. Al mergearlo se crea la etiqueta y el GitHub Release.",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Funcionalidades"
    },
    {
      "type": "fix",
      "section": "Correcciones"
    },
    {
      "type": "perf",
      "section": "Rendimiento"
    },
    {
      "type": "refactor",
      "section": "Cambios internos"
    },
    {
      "type": "docs",
      "section": "Documentación"
    },
    {
      "type": "build",
      "section": "Infraestructura",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "Integración continua",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Pruebas",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Mantenimiento",
      "hidden": true
    },
    {
      "type": "style",
      "section": "Estilo",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "package-name": "{{REPO}}",
      "changelog-path": "CHANGELOG.md"
    }
  }
}
